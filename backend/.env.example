#--------------------------------------------------------------------
# Zee Education - environment template
#
# COPY this file to  .env  and fill in your own values.
# The copy named `.env` is never shipped and must never be shared.
# ---------------------------------------------------------------
#   cp .env.example .env
#
# !  `.env` is git-ignored and MUST NEVER be committed.
# !  Never email it, paste it in chat, or upload it anywhere public.
# !  This template must contain PLACEHOLDERS ONLY.
#
# Brand name "Zee Education" is PROVISIONAL. Trademark, domain and
# legal clearance have NOT been completed.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# development | testing | production
# In `production`, CodeIgniter must never display debug detail.
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Use your real HTTPS origin in production. NEVER hard-code localhost.
app.baseURL = 'https://CHANGE_ME_YOUR_DOMAIN/'
app.indexPage = ''
app.forceGlobalSecureRequests = true
app.CSPEnabled = true

#--------------------------------------------------------------------
# PLATFORM IDENTITY
#--------------------------------------------------------------------
app.appTimezone = Asia/Karachi
app.defaultLocale = en
app.negotiationLanguage = en

#--------------------------------------------------------------------
# CORS ALLOW-LIST (security)
#--------------------------------------------------------------------
# `Access-Control-Allow-Origin: *` is FORBIDDEN on authenticated APIs.
# List explicit, real origins only - one per comma.
app.corsAllowedOrigins = 'https://CHANGE_ME_YOUR_DOMAIN'
app.corsAllowedMethods = 'GET,POST,PUT,PATCH,DELETE,OPTIONS'
app.corsAllowedHeaders = 'Authorization,X-Requested-With,Content-Type,Accept,Origin,X-Zee-Install'
app.corsSupportsCredentials = true

#--------------------------------------------------------------------
# COOKIE SECURITY
#--------------------------------------------------------------------
# Session/CSRF cookies receive the 'Secure' attribute when true (HTTPS
# only). Keep 'true' for production over HTTPS. Set to 'false' ONLY for
# plain-HTTP local development - with 'true', browsers drop the session
# cookie over plain HTTP and login will not persist.
cookie.secure = true
#--------------------------------------------------------------------
# CONTROL-PLANE DATABASE (Super Admin only)
#--------------------------------------------------------------------
# This database holds school and installation metadata only.
# It must NEVER contain student, guardian, staff, attendance, results
# or fee tables. Every school owns its OWN database (see below).
#
# hPanel prefixes both the database and the user with your account ID,
# e.g. YOURHOST_zee_control. Use the EXACT names hPanel shows you.
database.default.hostname = localhost
database.default.database = CHANGE_ME_CONTROL_DATABASE
database.default.username = CHANGE_ME_CONTROL_USER
database.default.password = CHANGE_ME_CONTROL_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# DEDICATED SCHOOL DATABASE (one school = one database)
#--------------------------------------------------------------------
# Most shared-hosting plans do NOT allow the application to run
# CREATE DATABASE. That is fine and fully supported.
#
# Method A (typical shared hosting):
#   1. Create one database + one MySQL user per school in your host panel.
#   2. Fill in the school database credentials below.
#   3. Add one ZEE_SCHOOL_DB_MAP entry per school, mapping the school
#      code you will use in the Super Admin panel to that school's
#      database name.
#
# Method B (server / VPS with sufficient privileges):
#   Create the database in the panel or via the panel's own tools, and
#   leave the prefix below so the school code is appended automatically.
#
# These values are read from the SERVER only. They are never accepted
# from a browser form and are never displayed back in any screen.
schooldb.default.hostname = localhost
schooldb.default.database = CHANGE_ME_SCHOOL_DATABASE
schooldb.default.username = CHANGE_ME_SCHOOL_USER
schooldb.default.password = CHANGE_ME_SCHOOL_PASSWORD
schooldb.default.port = 3306

# Prefix used when no explicit map entry matches. Letters, digits and
# underscore only.
ZEE_SCHOOL_DB_PREFIX = CHANGE_ME_SCHOOL_DB_PREFIX

# Explicit map: schoolcode=database_name[,schoolcode2=database_name2]
# The school code is what you type as "school code" when creating a
# school in the Super Admin panel.
ZEE_SCHOOL_DB_MAP = CHANGE_ME_CODE=CHANGE_ME_DATABASE

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate your own 64-character hexadecimal key. Any random hex string
# works. Do not copy an example value.
encryption.key = CHANGE_ME_64_HEX_CHARACTER_KEY

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# 4 = error | 9 = debug. Never log tokens, passwords or learner PII.
logger.threshold = 4

#--------------------------------------------------------------------
# DONE
#--------------------------------------------------------------------
# After saving:
#   1. delete this .env.example file so only one .env exists
#   2. open  https://your-domain/install  and run the setup wizard
#   3. run:  php tools/verify-package.php  (before uploading)
#--------------------------------------------------------------------