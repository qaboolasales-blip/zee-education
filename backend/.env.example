#--------------------------------------------------------------------
# Zee Education — Example Environment
#
# COPY THIS FILE to `.env` AND FILL IN YOUR OWN VALUES.
#   copy .env.example .env
#
# ⚠️  `.env` is git-ignored and must NEVER be committed.
# ⚠️  This file must contain PLACEHOLDERS ONLY — never a real
#     password, key, token, URL or customer credential.
# ⚠️  Do not put real student data in any local database.
#
# Brand name "Zee Education" is PROVISIONAL. Trademark and domain
# clearance have NOT been completed.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# development | testing | production
# In `production`, CodeIgniter must never display debug detail.
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Use a relative baseURL for local dev, or the real HTTPS origin in production.
# NEVER hard-code `localhost` or a preview URL into browser code.
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# PLATFORM IDENTITY
#--------------------------------------------------------------------
app.appTimezone = Asia/Karachi
app.defaultLocale = en
app.negotiationLanguage = en

#--------------------------------------------------------------------
# CORS ALLOWLIST (ADR-008 — security override)
#--------------------------------------------------------------------
# `Access-Control-Allow-Origin: *` is FORBIDDEN on authenticated APIs.
# List explicit, real origins only.
app.corsAllowedOrigins = 'https://app.example.edu,https://admin.example.edu'
app.corsAllowedMethods = 'GET,POST,PUT,PATCH,DELETE,OPTIONS'
app.corsAllowedHeaders = 'Authorization,X-Requested-With,Content-Type,Accept,Origin,X-Zee-Install'
app.corsSupportsCredentials = true

#--------------------------------------------------------------------
# DATABASE — SUPER ADMIN CONTROL PLANE ONLY (ADR-001)
#--------------------------------------------------------------------
# This database holds school/install metadata, commercial records,
# support and provisioning state.
#
# ⚠️  It must NEVER contain student, guardian, staff, attendance,
#     results or fee tables.
# ⚠️  Every school receives its OWN dedicated database, provisioned at
#     install time (Phase P3). A shared table with only `tenant_id` is
#     NOT an acceptable substitute.
database.default.hostname = localhost
database.default.database = zee_education_control
database.default.username = zee_placeholder_user
database.default.password = CHANGE_ME_STRONG_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# DATABASE — TESTS (kept separate so tests never truncate real data)
#--------------------------------------------------------------------
database.tests.hostname = localhost
database.tests.database = zee_education_control_test
database.tests.username = zee_placeholder_user
database.tests.password = CHANGE_ME_STRONG_PASSWORD
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate your own: php spark key:generate
# Used for app/session data encryption and future per-school installer
# credential envelope encryption (ADR-108).
encryption.key = CHANGE_ME_64_HEX_CHARACTER_ENCRYPTION_KEY

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# 4 = error | 9 = debug. Never log tokens, passwords or unnecessary
# student PII (ADR-002).
logger.threshold = 4
